[Unit]
Description={{ProjectNameLower}}-client-webapi
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory={{DeployRoot}}/clientwebapi
Environment=APP_ENVIRONMENT=Production
Environment=APP__HOST__LISTEN_ADDRESS=127.0.0.1:{{Port.ClientWebAPI}}
EnvironmentFile=-{{DeployRoot}}/config/shared.env
EnvironmentFile=-{{DeployRoot}}/config/client-webapi.env
ExecStart={{DeployRoot}}/clientwebapi/client_webapi
Restart=always
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=45
SyslogIdentifier={{ProjectNameLower}}-client-webapi
User=root

[Install]
WantedBy=multi-user.target
