[Unit]
Description={{ProjectNameLower}}-admin-webapi
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory={{DeployRoot}}/adminwebapi
Environment=APP_ENVIRONMENT=Production
Environment=APP__HOST__LISTEN_ADDRESS=127.0.0.1:{{Port.AdminWebAPI}}
EnvironmentFile=-{{DeployRoot}}/config/shared.env
EnvironmentFile=-{{DeployRoot}}/config/admin-webapi.env
ExecStart={{DeployRoot}}/adminwebapi/admin_webapi
Restart=always
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=45
SyslogIdentifier={{ProjectNameLower}}-admin-webapi
User=root

[Install]
WantedBy=multi-user.target
