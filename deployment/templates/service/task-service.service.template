[Unit]
Description={{ProjectNameLower}}-task-service
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory={{DeployRoot}}/taskservice
Environment=APP_ENVIRONMENT=Production
EnvironmentFile=-{{DeployRoot}}/config/shared.env
EnvironmentFile=-{{DeployRoot}}/config/task-service.env
ExecStart={{DeployRoot}}/taskservice/task_service
Restart=always
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=45
SyslogIdentifier={{ProjectNameLower}}-task-service
User=root

[Install]
WantedBy=multi-user.target
