[Unit]
Description=demo-client-webapi
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/var/appdata/demo/clientwebapi
Environment=APP_ENVIRONMENT=Production
Environment=APP__HOST__LISTEN_ADDRESS=127.0.0.1:30012
EnvironmentFile=-/var/appdata/demo/config/shared.env
EnvironmentFile=-/var/appdata/demo/config/client-webapi.env
ExecStart=/var/appdata/demo/clientwebapi/client_webapi
Restart=always
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=45
SyslogIdentifier=demo-client-webapi
User=root

[Install]
WantedBy=multi-user.target
