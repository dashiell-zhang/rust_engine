[Unit]
Description=demo-admin-webapi
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/var/appdata/demo/adminwebapi
Environment=APP_ENVIRONMENT=Production
Environment=APP__HOST__LISTEN_ADDRESS=127.0.0.1:30011
EnvironmentFile=-/var/appdata/demo/config/shared.env
EnvironmentFile=-/var/appdata/demo/config/admin-webapi.env
ExecStart=/var/appdata/demo/adminwebapi/admin_webapi
Restart=always
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=45
SyslogIdentifier=demo-admin-webapi
User=root

[Install]
WantedBy=multi-user.target
