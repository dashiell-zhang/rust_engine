[Unit]
Description=demo-task-service
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/var/appdata/demo/taskservice
Environment=APP_ENVIRONMENT=Production
EnvironmentFile=-/var/appdata/demo/config/shared.env
EnvironmentFile=-/var/appdata/demo/config/task-service.env
ExecStart=/var/appdata/demo/taskservice/task_service
Restart=always
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=45
SyslogIdentifier=demo-task-service
User=root

[Install]
WantedBy=multi-user.target
