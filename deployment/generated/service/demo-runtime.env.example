# 示例文件不会被服务自动加载。填写后建立：
# /var/appdata/demo/config/shared.env
# 或 admin-webapi.env、client-webapi.env、task-service.env（覆盖共享配置）。
# 真实凭据仅保存在服务器中，文件权限限定为服务账号可读。

# 同一唯一性范围的所有宿主共享 ID 协调 Redis、库编号和前缀。
APP__IDENTIFIER_GENERATOR__REDIS_CONNECTION="redis://:<password>@<shared-id-redis>:6379/0"
APP__IDENTIFIER_GENERATOR__INSTANCE_NAME="NetEngine.Identifier"

# 共享日志库、维护锁和稳定数据库标识保持一致。
APP__LOGGER__COMPONENT="database"
APP__LOGGER__CONNECTION="postgres://<writer>:<password>@<log-db>/<log-database>"
APP__LOGGER__MAINTENANCE_LOCK_CONNECTION="redis://:<password>@<shared-log-redis>:6379/0"
APP__LOGGER__DATABASE_IDENTITY="demo.SharedLogs"
APP__LOGGER__MAINTENANCE_LOCK_PREFIX="NetEngine:PartitionMaintenance:"
# APP__LOGGER__READ_CONNECTION="postgres://<reader>:<password>@<log-reader>/<log-database>"
# APP__LOGGER__PROJECT="<stable-project-name>"
APP__LOGGER__SAVE_DAYS="14"

# 广播互通实例使用相同连接、库编号、Scope 和保留期。
APP__EVENT_BUS__PROVIDER="redis"
APP__EVENT_BUS__SCOPE="demo:Production"
APP__EVENT_BUS__CONNECTION="redis://:<password>@<shared-event-redis>:6379/0"
APP__EVENT_BUS__RETENTION_MILLISECONDS="3600000"
# 数据库广播改用 provider=database 和独立 PostgreSQL 连接。
# APP__EVENT_BUS__PROVIDER="database"
# APP__EVENT_BUS__CONNECTION="postgres://<writer>:<password>@<event-db>/<event-database>"

# 业务库、缓存和业务锁按模块隔离；同一模块的 API/Worker 保持一致。
# APP__DATABASE__CONNECTION="postgres://<writer>:<password>@<business-db>/<business-database>"
# APP__DATABASE__READ_CONNECTION="postgres://<reader>:<password>@<business-reader>/<business-database>"
APP__CACHE__COMPONENT="redis"
APP__CACHE__CONNECTION="redis://:<password>@<business-redis>:6379/<module-number>"
APP__CACHE__PREFIX="demo:Business"
APP__LOCK__COMPONENT="redis"
APP__LOCK__CONNECTION="redis://:<password>@<business-redis>:6379/<module-number>"
APP__LOCK__PREFIX="demo:Business"
# APP__HOST__DATABASE_POOL__MAX_CONNECTIONS="20"
# APP__FILE__ROOT_PATH="/var/appdata/demo/storage"

# WebAPI 密钥、公开访问地址和文件目录由各宿主的 env 文件提供。
# APP__JWT__PRIVATE_KEY="<base64-ecdsa-private-key>"
# APP__JWT__PUBLIC_KEY="<base64-ecdsa-public-key>"
# APP__FILE__PUBLIC_BASE_URL="https://<api-domain>"
# 外部完整 TOML 配置路径不带 .toml 后缀；设置后不再读取随包默认文件。
# APP_CONFIG_PATH="/var/appdata/demo/config/<host>/appsettings"
